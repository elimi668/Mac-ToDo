/* ========== 全局 ========== */
* {
    font-family: "Segoe UI Variable", "SF Pro Text", "PingFang SC", "Microsoft YaHei UI", sans-serif;
    color: #1D1D1F;
}
#RootContainer { background-color: #F5F5F7; border-radius: 12px; }
#TitleBar { background: transparent; }
#TitleLabel { color: #1D1D1F; font-size: 13px; font-weight: 600; }
QPushButton#BtnClose, QPushButton#BtnMinimize {
    border: none; border-radius: 6px;
    min-width: 12px; min-height: 12px; max-width: 12px; max-height: 12px;
}
QPushButton#BtnClose { background-color: #FF5F57; }
QPushButton#BtnMinimize { background-color: #FEBC2E; }
QPushButton#BtnClose:hover { background-color: #E14640; }
QPushButton#BtnMinimize:hover { background-color: #E1A420; }
#Body { background: transparent; }
#TaskInputBar { background: transparent; }
QLineEdit#QuickInputEdit {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}
QLineEdit#QuickInputEdit:focus { border: 1px solid #007AFF; }
QComboBox#FilterCombo {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
    min-width: 60px;
}
QComboBox#FilterCombo:hover { border: 1px solid rgba(0, 0, 0, 0.15); }
QComboBox#FilterCombo::drop-down { border: none; width: 20px; }
QComboBox#FilterCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 6px;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
    outline: none;
}
QDateEdit#FilterCombo {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
}
QPushButton#AddButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#AddButton:hover { background-color: #0066D6; }
QPushButton#AddButton:pressed { background-color: #0055B3; }
#FilterRow { background: transparent; }
QScrollArea#TaskScroll { background: transparent; border: none; }
#TaskContainer { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0px; }
QScrollBar::handle:vertical { background: rgba(0,0,0,0.18); border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
#DateSection { color: #1D1D1F; font-size: 13px; font-weight: 600; padding: 8px 2px 4px 2px; }
QFrame#TaskCard {
    background-color: #FFFFFF;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.04);
}
QFrame#TaskCard:hover {
    background-color: #F0F0F0;
    border: 1px solid rgba(0, 0, 0, 0.10);
}
QLabel#TaskTitle { font-size: 14px; color: #1D1D1F; }
QLabel#TaskTitle[done="true"] { color: #86868B; }
QLabel#TaskSubtitle { font-size: 12px; color: #86868B; }
QLabel#TaskSubtitle[done="true"] { color: #AEAEB2; }
QCheckBox#TaskCheckbox { spacing: 0px; }
QCheckBox#TaskCheckbox::indicator {
    width: 18px; height: 18px; border-radius: 9px;
    border: 1.5px solid #C7C7CC; background-color: #FFFFFF;
}
QCheckBox#TaskCheckbox::indicator:hover { border: 1.5px solid #007AFF; }
QCheckBox#TaskCheckbox::indicator:checked {
    background-color: #007AFF; border: 1.5px solid #007AFF;
}
QDialog#TaskDialog, QDialog#ConfirmDialog { background-color: #F5F5F7; }
QLabel#ConfirmMessage { font-size: 14px; color: #1D1D1F; }
QLabel#ErrorLabel { color: #FF3B30; font-size: 12px; padding: 2px 4px; }
